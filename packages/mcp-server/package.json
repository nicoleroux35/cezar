{
  "name": "@open-mercato/cezar-mcp-server",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "description": "MCP server exposing cezar's orchestration capabilities",
  "bin": {
    "cezar-mcp": "./dist/index.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./endpoints": "./src/endpoints.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "check:coverage": "node scripts/check-coverage.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@open-mercato/cezar-api-client": "^0.14.0",
    "@open-mercato/cezar-contract": "^0.14.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.7.2"
  }
}
